# Copy to .env.local and fill in from Firebase console → Project settings → Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cagie-web.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cagie-web
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Web Push certificate (Cloud Messaging → Web configuration). Optional: defaults to the cagie-web key.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Local development against the emulators (npm run emulators) ──
# Use a demo project so nothing touches production:
# NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-cagie
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-cagie.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-cagie.appspot.com
# NEXT_PUBLIC_USE_EMULATORS=true
