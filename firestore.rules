rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users ───
    // Anyone authenticated can read users (needed for pair code lookup).
    // Only the document owner can write their own profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
                    // Also allow a partner to set coupleId on the other user during pairing
                    || (request.auth != null
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coupleId']));
    }

    // ─── Couples ───
    match /couples/{coupleId} {
      // Only members of the couple can read
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.members;

      // Any authenticated user can create a couple (during pairing)
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members;

      // Only members can update (e.g. adding a second member)
      allow update: if request.auth != null
                    && (request.auth.uid in resource.data.members
                        || request.auth.uid in request.resource.data.members);

      // ─── Subcollections under couples (events, notes, dashboard) ───
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
      }
    }
  }
}
